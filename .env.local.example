# ===== Sanity CMS =====
# מזהי הפרויקט והדאטהסט — ציבוריים, נחשפים בדפדפן (נדרש לסטודיו המוטמע)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# טוקן קריאה — לא נדרש. ה-dataset ציבורי, והאתר קורא ממנו בלי אימות.
# הקוד לא מגדיר אותו בכלל, ולכן טוקן שמוגדר בסביבה פשוט לא בשימוש.
# (טוקן ששייך לפרויקט אחר היה שובר את הקריאות לגמרי — ראו docs/decisions.md 29.)

# טוקן כתיבה — סוד. נדרש רק להרצת scripts/seed-sanity.ts, לא לאתר עצמו.
# מונפק ב-sanity.io/manage תחת API > Tokens (הרשאת Editor)
SANITY_API_WRITE_TOKEN=your_write_token

# סוד משותף ל-webhook הרענון. מחרוזת אקראית שתבחרו,
# ותדביקו גם בהגדרת ה-webhook ב-sanity.io/manage ככותרת x-revalidate-secret.
# בלעדיו הראוט /api/revalidate סגור ומחזיר 503.
SANITY_REVALIDATE_SECRET=your_random_secret

# ===== לידים (קיים) =====
# יעד ה-webhook לשליחת לידים מהצ'אטבוט וממרכיב המארז
LEAD_WEBHOOK_URL=
