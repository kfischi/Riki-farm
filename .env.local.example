# ===== Sanity CMS =====
# מזהי הפרויקט והדאטהסט — ציבוריים, נחשפים בדפדפן (נדרש לסטודיו המוטמע)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# טוקן קריאה — סוד. צד שרת בלבד, לעולם לא NEXT_PUBLIC_
# מונפק ב-sanity.io/manage תחת API > Tokens (הרשאת Viewer)
SANITY_API_READ_TOKEN=your_read_token

# ===== לידים (קיים) =====
# יעד ה-webhook לשליחת לידים מהצ'אטבוט וממרכיב המארז
LEAD_WEBHOOK_URL=
